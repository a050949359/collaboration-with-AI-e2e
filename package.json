{
  "name": "collaboration-with-ai-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E smoke tests for collaboration-with-AI (ohya.vip)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:guest": "playwright test --project=guest",
    "test:user": "playwright test --project=user",
    "test:admin": "playwright test --project=admin",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "auth:login": "playwright test --project=setup --headed",
    "report": "playwright show-report",
    "docker:test": "docker compose run --rm e2e",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

# Target base URL. Defaults to the deployed environment.
# Switch to local dev with: BASE_URL=http://localhost docker compose run --rm e2e
BASE_URL=https://ohya.vip

# --- Optional: credentials for capturing logged-in storageState ---
# Used only by the `setup` project (npm run auth:login). Leave blank to skip.
# Google OAuth path bypasses Turnstile (Turnstile only guards email/password form).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
